# .env.example - Variables de entorno recomendadas

# Puerto de la aplicación
PORT=3000

# Token de administrador (requerido para operaciones administrativas)
ADMIN_TOKEN=diego

# MongoDB (opcional, si no se proporciona usa almacenamiento en archivo)
#MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=dashboard
MONGODB_DB=ms-dashboard

# Directorio de datos (usado cuando no hay MongoDB)
DATA_DIR=./data

# Directorio OpenAPI
# OPENAPI_DIR=./kit/openapi

# Configuración del monitor de servicios
MONITOR_INTERVAL_MS=120000

# Timeout para verificación de servicios (ms)
CHECK_TIMEOUT_MS=20000

# Permitir URLs privadas en verificaciones (0 o 1)
ALLOW_PRIVATE_URLS=1

# Configuración para mock servers
MOCK_PORT=4000
# MOCK_HOY=YYYY-MM-DD (fecha para pruebas, si no se define usa la actual)

# ==============================================================
# GUÍA DE ETAPA 2 - Controla si está disponible para descargar
# ==============================================================
# 
# Cambiar entre:
#   GUIDE_ETAPA2_ENABLED=0  ← Guía OCULTA (por defecto)
#   GUIDE_ETAPA2_ENABLED=1  ← Guía VISIBLE
#
# Cuando está habilitada (=1):
#   - Botón "📖 Guía PDF" aparece en el Dashboard
#   - Los usuarios pueden descargar GUIA_REGISTRO_ETAPA2.pdf
#
# Cuando está deshabilitada (=0):
#   - Botón "📖 Guía PDF" está OCULTO
#   - El PDF no es accesible desde la UI
#   - Pero aún está disponible en /public/GUIA_REGISTRO_ETAPA2.pdf
#
GUIDE_ETAPA2_ENABLED=0
